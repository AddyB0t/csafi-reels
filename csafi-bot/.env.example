# Copy to .env and fill in. Empty values turn that feature off.

# ---------- Dashboard ----------
PORT=8765
# Optional login for the dashboard. Set it if other people on the network can reach the port.
DASHBOARD_TOKEN=
# Largest video you can upload in the dashboard, in MB.
MAX_UPLOAD_MB=500

# ---------- Local AI (Ollama) ----------
# auto = use Ollama if it is running, else write a mock draft. ollama = fail if Ollama is down.
AI_BACKEND=auto
# Outside Docker: http://127.0.0.1:11434. docker-compose sets this for you.
OLLAMA_URL=http://127.0.0.1:11434
# Check exact tags on https://ollama.com/library before pulling. 8 GB VRAM fallbacks: qwen2.5vl:3b, gemma3:4b
VISION_MODEL=qwen2.5vl:7b
TEXT_MODEL=qwen3:8b

# ---------- Media ----------
# tiny, base, small, medium, large-v3, large-v3-turbo (also baked into the Docker image at build)
WHISPER_MODEL=small
# auto tries the GPU and falls back to CPU. Set cpu if CUDA gives errors.
WHISPER_DEVICE=auto
# Empty = detect. Example: en, hi
WHISPER_LANGUAGE=
MAX_FRAMES=14
FRAME_WIDTH=768
# Also save the key frames as FRAME 01 - ... .jpg files in each reel folder.
SAVE_FRAMES=false

# ---------- Optional Google Drive mirror (rclone) ----------
# Empty = off. Put rclone.conf in ./rclone/ (Docker) or run `rclone config` (no Docker). Example: gdrive:CSAFI Reels Library
RCLONE_REMOTE=
