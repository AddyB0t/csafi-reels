# Copy to .env and fill in. Empty values turn that feature off.

# ---------- Dashboard ----------
PORT=8765
# Required if the dashboard is reachable through a tunnel. Any long random string.
DASHBOARD_TOKEN=

# ---------- Meta / Instagram webhook ----------
# Any word you choose; paste the same word in the Meta App Dashboard webhook form.
META_VERIFY_TOKEN=
# Meta App Dashboard > App settings > Basic > App secret. Used to check webhook signatures.
META_APP_SECRET=
# Optional: comma-separated Instagram sender IDs allowed to submit reels. Empty = anyone.
ALLOWED_SENDER_IDS=

# ---------- Local AI (Ollama) ----------
# auto = use Ollama if it is running, else write a mock draft. ollama = fail if Ollama is down.
AI_BACKEND=auto
# Outside Docker: http://127.0.0.1:11434. docker-compose sets this for you.
OLLAMA_URL=http://127.0.0.1:11434
# Check exact tags on https://ollama.com/library before pulling. 8 GB VRAM fallbacks: qwen2.5vl:3b, gemma3:4b
VISION_MODEL=qwen2.5vl:7b
TEXT_MODEL=qwen3:8b

# ---------- Media ----------
# tiny, base, small, medium, large-v3, large-v3-turbo (also baked into the Docker image at build)
WHISPER_MODEL=small
# auto tries the GPU and falls back to CPU. Set cpu if CUDA gives errors.
WHISPER_DEVICE=auto
# Empty = detect. Example: en, hi
WHISPER_LANGUAGE=
MAX_FRAMES=14
FRAME_WIDTH=768
# Also save the key frames as FRAME 01 - ... .jpg files in each reel folder.
SAVE_FRAMES=false

# ---------- Telegram (free, create a bot with @BotFather) ----------
TELEGRAM_BOT_TOKEN=
# Your chat ID: send /id to your bot after enabling intake, or use @userinfobot.
TELEGRAM_CHAT_ID=
# true = anyone allowed can send a reel link to the bot to queue it (no public URL needed).
TELEGRAM_INTAKE=false
TELEGRAM_ALLOWED_USER_IDS=

# ---------- Optional Google Drive mirror (rclone) ----------
# Put rclone.conf in ./rclone/ (Docker) or run `rclone config` (no Docker). Example: gdrive:CSAFI Reels Library
RCLONE_REMOTE=

# ---------- Optional ngrok tunnel (docker compose --profile tunnel up -d) ----------
NGROK_AUTHTOKEN=
# Your free static domain, e.g. something-random.ngrok-free.app
NGROK_DOMAIN=
